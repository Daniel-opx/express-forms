<!-- views/createUser.ejs -->
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <style>
    :root {
      color-scheme: light;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #172033;
      background: #f4f6fb;
    }

    * {
      box-sizing: border-box;
    }

    body {
      max-width: 880px;
      margin: 0 auto;
      padding: 48px 20px;
    }

    h1 {
      margin: 0 0 8px;
      font-size: clamp(1.8rem, 4vw, 2.4rem);
    }

    .intro {
      margin: 0 0 28px;
      color: #647084;
    }

    .form-card {
      padding: 24px;
      border: 1px solid #e1e6ef;
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 8px 24px rgb(23 32 51 / 5%);
    }

    .form-fields {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px 16px;
    }

    .form-field-full {
      grid-column: 1 / -1;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: 0.9rem;
      font-weight: 600;
    }

    input {
      width: 100%;
      min-height: 44px;
      padding: 10px 12px;
      border: 1px solid #cbd3df;
      border-radius: 8px;
      font: inherit;
    }

    input:focus {
      border-color: #4263eb;
      outline: 3px solid rgb(66 99 235 / 16%);
    }

    .form-actions {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 22px;
    }

    button {
      display: inline-block;
      min-height: 42px;
      padding: 10px 16px;
      border: 0;
      border-radius: 8px;
      background: #4263eb;
      color: #fff;
      font: inherit;
      font-weight: 600;
      cursor: pointer;
    }

    button:hover {
      background: #3451c6;
    }

    .text-link {
      color: #3451c6;
      font-weight: 600;
    }

    .form-errors {
      margin: 0 0 20px;
      padding: 14px 18px 14px 38px;
      border: 1px solid #f1b8b5;
      border-radius: 8px;
      background: #fff5f4;
      color: #b42318;
    }

    @media (max-width: 520px) {
      body {
        padding: 28px 16px;
      }

      .form-card {
        padding: 18px;
      }
    }
  </style>
</head>
<body>
  <h1><%= title %></h1>
  <p class="intro">Add a new user to your list.</p>
  <section class="form-card">
    <%- include("partials/errors.ejs") %>
    <form action="/create" method="POST">
      <div class="form-fields">
        <div>
          <label for="firstName">First Name</label>
          <input type="text" name="firstName" id="firstName" >
        </div>
        <div>
          <label for="lastName">Last Name</label>
          <input type="text" name="lastName" id="lastName" >
        </div>
        <div>
          <label for="email">Email</label>
          <input type="email" name="email" id="email" >
        </div>
        <div>
          <label for="age">Age</label>
          <input type="number" name="age" id="age" >
        </div>
        <div class="form-field-full">
          <label for="bio">Bio</label>
          <input type="text" name="bio" id="bio" >
        </div>
      </div>
      <div class="form-actions">
        <button type="submit">Create user</button>
        <a class="text-link" href="/">Back to home</a>
      </div>
    </form>
  </section>
</body>
</html>
