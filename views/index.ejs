<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <style>
    :root {
      color-scheme: light;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #172033;
      background: #f4f6fb;
    }

    * {
      box-sizing: border-box;
    }

    body {
      max-width: 880px;
      margin: 0 auto;
      padding: 48px 20px;
    }

    h1 {
      margin: 0 0 8px;
      font-size: clamp(1.8rem, 4vw, 2.4rem);
    }

    .intro {
      margin: 0 0 28px;
      color: #647084;
    }

    .search-card,
    .user-list {
      padding: 24px;
      border: 1px solid #e1e6ef;
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 8px 24px rgb(23 32 51 / 5%);
    }

    .search-card {
      margin-bottom: 24px;
    }

    .search-card h2 {
      margin: 0 0 18px;
      font-size: 1.15rem;
    }

    .search-fields {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: 0.9rem;
      font-weight: 600;
    }

    input {
      width: 100%;
      min-height: 44px;
      padding: 10px 12px;
      border: 1px solid #cbd3df;
      border-radius: 8px;
      font: inherit;
    }

    input:focus {
      border-color: #4263eb;
      outline: 3px solid rgb(66 99 235 / 16%);
    }

    .search-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 18px;
    }

    button,
    .create-link {
      display: inline-block;
      min-height: 42px;
      padding: 10px 16px;
      border: 0;
      border-radius: 8px;
      background: #4263eb;
      color: #fff;
      font: inherit;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
    }

    button:hover,
    .create-link:hover {
      background: #3451c6;
    }

    .text-link,
    .user-actions a {
      color: #3451c6;
      font-weight: 600;
    }

    .list-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
    }

    .list-heading h2 {
      margin: 0;
      font-size: 1.2rem;
    }

    .user-list ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .user-list li {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 16px 0;
      border-top: 1px solid #edf0f5;
    }

    .user-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .user-actions form {
      margin: 0;
    }

    .user-actions button {
      min-height: auto;
      padding: 0;
      background: none;
      color: #b42318;
      font-size: 0.95rem;
    }

    .user-actions button:hover {
      background: none;
      text-decoration: underline;
    }

    @media (max-width: 520px) {
      body {
        padding: 28px 16px;
      }

      .search-card,
      .user-list {
        padding: 18px;
      }

      .user-list li {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <h1><%= title %></h1>
  <p class="intro">Find a user by name, email, or both.</p>

  <section class="search-card" aria-labelledby="search-heading">
    <h2 id="search-heading">Search users</h2>
    <form action="/search" method="GET">
      <div class="search-fields">
        <div>
          <label for="name">Name</label>
          <input id="name" name="name" type="search" placeholder="e.g. Alex Morgan">
        </div>
        <div>
          <label for="email">Email</label>
          <input id="email" name="email" type="search" placeholder="e.g. alex@example.com">
        </div>
      </div>
      <div class="search-actions">
        <button type="submit">Search</button>
        <a class="text-link" href="/">Clear</a>
      </div>
    </form>
  </section>

  <section class="user-list" aria-labelledby="users-heading">
    <div class="list-heading">
      <h2 id="users-heading">Users</h2>
      <a class="create-link" href="/create">Create a user</a>
    </div>
    <ul>
      <% if (locals.users) { %>
        <% users.forEach(function(user) { %>
          <li>
            <span>ID: <%= user.id %>, Name: <%= user.firstName %> <%= user.lastName %></span>
            <div class="user-actions">
              <a href="/<%= user.id %>/update">Update</a>
              <form action="/<%= user.id %>/delete" method="POST">
                <button type="submit" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
              </form>
            </div>
          </li>
        <% }); %>
      <% } %>
    </ul>
  </section>
</body>
</html>
